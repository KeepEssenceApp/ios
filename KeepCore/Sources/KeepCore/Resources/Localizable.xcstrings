    "connect.own.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a remote server to its MCP configuration: the connect address, Streamable HTTP transport, OAuth authentication."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在它的 MCP 配置里加一个远程服务器，地址填接入地址，传输选 Streamable HTTP，认证选 OAuth。"
          }
        }
      }
    },
    "connect.own.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It opens the KeepEssence allow page. Press Allow."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它打开 KeepEssence 的允许页，点「允许」。"
