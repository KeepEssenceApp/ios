        }
      }
    },
    "connect.own.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give it a timetable: each time it asks what work there is, claims it, and hands it back when done."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给它设一个定时任务：每次来先问有什么活，认领，做完交回。"
          }
        }
      }
    },
