    "connect.gemini.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For now: United States only, 18 or older, a personal Google account, English, with History on. Gemini asks you every time it saves a note."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前只限美国、18 岁以上、个人 Google 账号、英文，并且要开着 History。存回笔记时 Gemini 每次都会让你确认。"
          }
        }
      }
    },
    "connect.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the connect address in the assistant. It opens the KeepEssence allow page, and you press Allow."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把接入地址填进助手那边，它会打开 KeepEssence 的允许页，你点「允许」。"
          }
        }
      }
    },
    "connect.not_credential": {
      "extractionState": "manual",
