    "calendar.counts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld saved · %2$lld digests · %3$lld read · %4$lld notes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存入 %1$lld 条 · 每日摘要 %2$lld 份 · 读了 %3$lld 份 · 笔记 %4$lld 篇"
          }
        }
      }
    },
    "connect.address": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect address"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接入地址"
          }
        }
      }
    },
    "connect.chatgpt.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a computer, open chatgpt.com/plugins and choose + → Add custom MCP server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在电脑上打开 chatgpt.com/plugins，点 + → Add custom MCP server。"
          }
        }
      }
    },
    "connect.chatgpt.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name it KeepEssence, paste the connect address as the Server URL, and choose OAuth."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名字填 KeepEssence，Server URL 粘贴接入地址，认证选 OAuth。"
          }
        }
      }
    },
    "connect.chatgpt.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the risk notice and confirm, choose Create as a plugin, then install it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看过风险提示后确认，点 Create as a plugin，再安装它。"
          }
        }
      }
    },
    "connect.chatgpt.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The browser opens the KeepEssence allow page. Press Allow."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览器打开 KeepEssence 的允许页，点「允许」。"
          }
        }
      }
    },
    "connect.chatgpt.kind": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat: deep dives only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话型：只做深挖"
          }
        }
      }
    },
    "connect.chatgpt.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It connects and works on the web only, not on a phone. Personal plans can only read: afterwards, come back to the deep-dive queue and paste the result back."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能在网页上接和用，手机上不行。个人套餐只能读：聊完后回到深挖队列，点「把结果贴回来」。"
          }
        }
      }
    },
    "connect.claude.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Connectors in Claude and choose Add → Add custom connector."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Claude 的 Connectors，点 Add → Add custom connector。"
          }
        }
      }
    },
    "connect.claude.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name it KeepEssence, paste the connect address, and choose Continue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名字填 KeepEssence，地址粘贴接入地址，点 Continue。"
          }
        }
      }
    },
    "connect.claude.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the authentication it detects, choose Add, then Connect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "认证保持它自动检测到的选项，点 Add，再点 Connect。"
          }
        }
      }
    },
    "connect.claude.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The browser opens the KeepEssence allow page. Press Allow."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览器打开 KeepEssence 的允许页，点「允许」。"
          }
        }
      }
    },
    "connect.claude.kind": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat: deep dives only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话型：只做深挖"
          }
        }
      }
    },
    "connect.claude.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every plan can connect; the free plan allows one custom connector. Claude asks you the first time it saves a note."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各套餐都能接；免费套餐只能有一个自定义连接器。Claude 第一次存回笔记时会问你是否允许。"
          }
        }
      }
    },
    "connect.content_goes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once connected, your content is sent to where that assistant runs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接入之后，内容会被送到这个助手运行的地方。"
          }
        }
      }
    },
    "connect.gemini.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a computer, open gemini.google.com and go to Connected Apps in its menu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在电脑上打开 gemini.google.com，在它的菜单里进 Connected Apps。"
          }
        }
      }
    },
    "connect.gemini.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Under Custom apps choose Add a custom app, paste the connect address, and choose Next."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Custom apps 下点 Add a custom app，粘贴接入地址，点 Next。"
          }
        }
      }
    },
    "connect.gemini.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The browser opens the KeepEssence allow page. Press Allow."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览器打开 KeepEssence 的允许页，点「允许」。"
          }
        }
      }
    },
    "connect.gemini.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After that it works on the phone and the web: type @ in a conversation and pick KeepEssence."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之后手机和网页都能用：对话里输入 @ 选 KeepEssence。"
          }
        }
      }
    },
    "connect.gemini.kind": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat: deep dives only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
