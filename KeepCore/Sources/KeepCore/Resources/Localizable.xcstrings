    "digest.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No daily digest yet. There is one a day, written after 21:00 (%@) when the day has at least one analysed item; a missed day is folded into the next one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有每日摘要。每天一份，当天至少有一条解读好的条目时，在 21:00（%@）之后出；漏掉的一天并进下一份。"
          }
        }
      }
    },
    "digest.none.no_assistant": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No assistant is set to write the daily digest, so none is written. Today's analyses are in Today."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有指定出每日摘要的助手，所以不会有每日摘要。今天的解读都在「今天」里。"
          }
        }
      }
    },
    "digest.none.not_yet_time": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's daily digest is written after 21:00 (%@). It needs at least one analysed item from today. Until then, today's analyses are in Today."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的每日摘要在 21:00（%@）之后出。它需要今天至少有一条解读好的条目。在那之前，今天的解读都在「今天」里。"
          }
        }
      }
    },
    "digest.none.nothing_analysed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No daily digest today yet: it needs at least one analysed item, and none of today's items is analysed. Once one is, the digest is written after 21:00 (%@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天还没有每日摘要：它需要至少一条解读好的条目，而今天的条目都还没解读。有了解读，每日摘要在 21:00（%@）之后出。"
          }
        }
      }
    },
